/models/
*.onnx
*.gguf
*.ggml
*.gguf
tests/samples/large/

# Local settings
.claude/settings.local.json
.env
.env.*
!.env.example

# Helper programs fetched at build time and shipped in the installer (tools/fetch-engines.ps1)
/tools/engines/

# Claude Code agent worktrees
/.claude/worktrees/

# Installer build output (installer/build.ps1)
/publish/
/Releases/

# Android (android/): Gradle and build outputs, local SDK path, signing material (never committed)
/android/.gradle/
/android/.kotlin/
/android/build/
/android/app/build/
/android/local.properties
/android/captures/
*.jks
*.keystore
# macOS / Linux desktop packages (installer/macos/build-macos.sh, installer/linux/build-linux.sh)
/build/
