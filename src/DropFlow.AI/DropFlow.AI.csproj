<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Two builds of the same engine:
      net10.0-windows10.0.19041.0  Windows OCR (Windows.Media.Ocr), Windows PDF rendering (Windows.Data.Pdf) and Windows face detection
                                   (Windows.Media.FaceAnalysis): Platform/Windows/**.
      net10.0                      macOS and Linux (and any other host): Tesseract OCR, PDFium page rendering, the ONNX face model:
                                   Platform/Unix/**.
    Everything outside Platform/ is shared. A project that targets net10.0-windows* gets the Windows build automatically.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'windows'">
    <Compile Remove="Platform/Unix/**" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' != 'windows'">
    <Compile Remove="Platform/Windows/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DropFlow.AI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DropFlow.Core\DropFlow.Core.csproj" />
    <ProjectReference Include="..\DropFlow.Engines.Common\DropFlow.Engines.Common.csproj" />
    <!-- pdf.translate reads the text layer through PdfTextReader (PdfPig reading order, headings, lists, tables). -->
    <ProjectReference Include="..\DropFlow.Engines.Pdf\DropFlow.Engines.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <!-- PDFium page rendering for pdf.ocr where Windows.Data.Pdf does not exist (also usable on Windows). -->
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

</Project>
