<Window x:Class="DropFlow.Spike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropFlow Spike — Phase 0" Width="820" Height="600">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Drag a file from Explorer / desktop / a browser download, then tap Shift, Ctrl or Alt." />
            <TextBlock x:Name="Status" Margin="0,6,0,0" Foreground="DimGray" TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="DimGray"
                       Text="Expected: a wheel appears centred under the cursor, accepts the drop and logs the paths. Watch for: Explorer showing move/copy/link cursor changes, the Alt menu bar flashing, the wheel on the wrong monitor or the wrong size." />
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Clear log" Padding="14,6" Click="OnClear" />
            <Button Content="Copy log" Padding="14,6" Margin="8,0,0,0" Click="OnCopy" />
        </StackPanel>
    </Grid>
</Window>
