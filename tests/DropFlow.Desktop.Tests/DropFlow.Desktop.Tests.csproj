<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure logic of the macOS/Linux app (drag decisions, protocols, file plans, settings). Runs on Windows, macOS and Linux. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- no Avalonia build-time statistics (see src/DropFlow.Desktop/DropFlow.Desktop.csproj) -->
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DropFlow.Desktop\DropFlow.Desktop.csproj" />
    <ProjectReference Include="..\DropFlow.TestSupport\DropFlow.TestSupport.csproj" />
  </ItemGroup>

</Project>
