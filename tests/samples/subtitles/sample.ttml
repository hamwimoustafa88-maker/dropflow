<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" ttp:frameRate="25" ttp:tickRate="10000000" xml:lang="ar">
  <head>
    <styling>
      <style xml:id="it" tts:fontStyle="italic"/>
    </styling>
  </head>
  <body>
    <div>
      <p begin="00:00:01.000" end="00:00:03.500">Hello
        <span tts:fontWeight="bold">world</span><br/>second line</p>
      <p begin="40000000t" dur="2s" style="it">مرحبا بالعالم</p>
      <p begin="00:00:07:12" end="00:00:09:00">Frames &amp; ticks</p>
    </div>
  </body>
</tt>
