# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# DropFlow Web: generated at install/build time (scripts/vendor.mjs, scripts/build-sw.mjs)
/public/vendor
/public/sw.js
/.next-*
/.vitest
# build-time TTF for the share images (scripts/og-font.mjs)
/.og-cache

# written by scripts/csp-hashes.mjs between the two build passes
/csp-hashes.json
