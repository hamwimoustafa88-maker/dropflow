  "faq": {
    "title": "FAQ",
    "items": [
      {
        "q": "Is DropFlow free?",
        "a": "Yes. Free and open source, under the GPL-3.0."
      },
      {
        "q": "Does it upload my files?",
        "a": "No. Everything is converted on your device, in the Windows app or inside your browser."
      },
      {
        "q": "Which formats?",
        "a": "PDF, images, video, audio, documents and archives: {conversions} conversions."
      },
      {
        "q": "Does it work offline?",
        "a": "Yes. The Windows app works fully offline, and the web app works offline after your first visit."
      },
      {
        "q": "How can I contribute?",
        "a": "The code is on GitHub. Start with CONTRIBUTING.md; good first issues are welcome."
      },
      {
        "q": "Is there a Mac version?",
        "a": "Not yet. It is planned."
      }
    ]
  },
